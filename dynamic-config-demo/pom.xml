<?xml version="1.0" encoding="UTF-8"?>

<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="
            http://maven.apache.org/POM/4.0.0
            https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.dynamicconfig</groupId>
        <artifactId>dynamic-config-sdk</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>dynamic-config-demo</artifactId>
    <name>dynamic-config-demo</name>
    <description>Runnable examples for the Dynamic Config SDK</description>

    <properties>
        <exec.mainClass>io.dynamicconfig.demo.CoreDemo</exec.mainClass>
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>

        <dependency>
            <groupId>io.dynamicconfig</groupId>
            <artifactId>dynamic-config-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>io.dynamicconfig</groupId>
            <artifactId>dynamic-config-spring</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>io.dynamicconfig</groupId>
            <artifactId>dynamic-config-kubernetes</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context</artifactId>
            <version>${spring.version}</version>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <mainClass>${exec.mainClass}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
